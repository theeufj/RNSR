# Copy to a deployment .env or pass with --env-file. Settings.from_env() uses
# this preset before individual RNSR_* overrides. Research defaults are unchanged.
RNSR_PROFILE=production

# One query: batches scale these caps sub-linearly with question count.
RNSR_MAX_ROOT_ITERS=32
RNSR_MAX_SUB_CALLS=128
RNSR_MAX_WALL_S=600
RNSR_MAX_SPEND_USD=2

# One process lifetime: tune for workload and provider quotas. Spend limits
# refuse future calls after recorded usage reaches the ceiling; in-flight calls
# can still complete. Unknown model pricing needs operator review.
RNSR_MAX_IN_FLIGHT_REQUESTS=8
RNSR_MAX_REQUESTS_PER_MINUTE=120
RNSR_RUN_SPEND_CEILING_USD=25
RNSR_SUB_CONCURRENCY=8
RNSR_SERVICE_MAX_JOBS=50

# Operational audit events retained for thirty days. Document-bearing values
# become length/digest descriptors. Retention runs before queries/service jobs;
# idle deployments should schedule cleanup if expiry must be immediate.
RNSR_TRAJECTORY_CONTENT=redacted
RNSR_TRAJECTORY_RETENTION_DAYS=30
RNSR_LOG_FORMAT=json

# Set secrets through the deployment secret store. An optional Fernet key adds
# encryption at rest (requires rnsr[secure]); a missing key leaves redacted logs
# readable. Tokens and corpus roots are mandatory for the HTTP service.
RNSR_TRAJECTORY_KEY=
RNSR_SERVICE_TOKEN=
RNSR_SERVICE_CORPUS_ROOT=/data/corpora
RNSR_RUN_DIR=/data/runs

# Configure a provider key and model roles separately. This preset deliberately
# inherits the selected provider/models and keeps corpus health/review gates on.
