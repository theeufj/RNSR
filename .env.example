# RNSR Environment Variables
# Copy this file to .env and fill in your values.
#
# RNSR looks for .env in your current working directory first, then in the
# project root (for dev checkouts).  You can also pass api_key directly:
#
#   from rnsr import RNSRClient
#   client = RNSRClient(api_key="your-key", llm_provider="gemini")

# =============================================================================
# LLM Provider API Keys (set at least one)
# =============================================================================

# Google Gemini (Recommended - best price/performance)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Model Configuration (Optional - uses defaults if not set)
# =============================================================================

# LLM Provider: "openai", "anthropic", "gemini", or "auto" (auto-detect)
LLM_PROVIDER=auto


# Model overrides (leave blank to use provider defaults)
# OpenAI: gpt-5-mini (default), gpt-5.2, gpt-5.2-pro (legacy: gpt-4o-mini, gpt-4.1)
# Anthropic: claude-sonnet-4-5 (default), claude-haiku-4-5, claude-opus-4-5
# Gemini: gemini-2.5-flash (default), gemini-3-flash-preview, gemini-3-pro-preview
SUMMARY_MODEL=
AGENT_MODEL=

# Entity extraction model override - use a small, fast model to speed up extraction
# e.g. gemini-2.5-flash, gpt-5-mini
RNSR_EXTRACTION_MODEL=
# Entity extraction provider override (openai, anthropic, gemini) - optional
RNSR_EXTRACTION_PROVIDER=

# Extraction mode: "json" (fast, 1 LLM call) or "code" (grounded, 2+ LLM calls)
# Default: json
RNSR_EXTRACTION_MODE=json

# Enable ToT validation for extraction (code mode only, slower but more accurate)
# Default: false (disabled for speed)
RNSR_EXTRACTION_VALIDATE=false

# Parallel extraction workers (I/O-bound LLM calls, safe to increase)
# Default: 16
RNSR_EXTRACTION_WORKERS=16

# Embedding model overrides
# OpenAI: text-embedding-3-small (default)
# Gemini: text-embedding-004 (default), gemini-embedding-001
EMBEDDING_MODEL=

# =============================================================================
# Determinism & Anti-Hallucination
# =============================================================================

# Fixed seed for LLM sampling (OpenAI and Gemini support this)
# Default: 42
RNSR_LLM_SEED=42

# Enable disk-based LLM response cache for 100% deterministic re-runs.
# Cached responses are stored in .rnsr_cache/llm/ (or RNSR_LLM_CACHE_DIR).
# Default: false
RNSR_LLM_CACHE=false

# Custom directory for LLM response cache
# Default: .rnsr_cache/llm
# RNSR_LLM_CACHE_DIR=.rnsr_cache/llm

# Require source-text grounding for extracted entities.
# When true, entities whose canonical_name cannot be found in the source
# text are filtered out. This prevents hallucinated entities at the cost
# of occasionally missing entities the LLM rephrased.
# Default: false
RNSR_REQUIRE_GROUNDING=false

# =============================================================================
# Storage
# =============================================================================

# KV Store database path
KV_STORE_PATH=./data/kv_store.db

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
