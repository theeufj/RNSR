# rnsr (DocDB-RLM) environment variables.
# Copy to .env and fill in values. Loaded by Settings.from_env().

# ---------------------------------------------------------------------------
# LLM provider API keys (set at least one)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Provider: openai | anthropic | gemini | auto (auto-detect from keys)
RNSR_PROVIDER=auto

# ---------------------------------------------------------------------------
# Model roles (blank -> provider defaults in rnsr/llm/router.py)
# root   = orchestrator LM driving the REPL loop
# sub    = cheap batched sub-LM (semantic_annotate, rung-3/5, prose checks)
# embed  = rung-4 lazy embeddings
# vision = table-extraction fallback on rasterized page crops
# ---------------------------------------------------------------------------
RNSR_ROOT_MODEL=
RNSR_SUB_MODEL=
RNSR_EMBED_MODEL=
RNSR_VISION_MODEL=

# ---------------------------------------------------------------------------
# Budgets (spec §7) — hard caps per query
# ---------------------------------------------------------------------------
RNSR_MAX_ROOT_ITERS=20
RNSR_MAX_SUB_CALLS=300
RNSR_MAX_WALL_S=600
RNSR_MAX_SPEND_USD=2.0
RNSR_SUB_CONCURRENCY=16

# ---------------------------------------------------------------------------
# Run-level governance — the budgets above cap ONE query; these cap the run.
# 0 disables a limit.
# ---------------------------------------------------------------------------
RNSR_MAX_IN_FLIGHT_REQUESTS=24    # concurrent provider requests, all roles
RNSR_MAX_REQUESTS_PER_MINUTE=0    # sliding-window RPM ceiling
RNSR_RUN_SPEND_CEILING_USD=0      # aggregate USD before calls are refused

# ---------------------------------------------------------------------------
# Trajectory data protection — trajectories quote client documents verbatim
# ---------------------------------------------------------------------------
# full | redacted (document values become length + digest) | metadata (dropped)
RNSR_TRAJECTORY_CONTENT=full
# Fernet key to encrypt each line at rest; needs pip install 'rnsr[secure]'.
# Generate: python -c "from cryptography.fernet import Fernet; \
#   print(Fernet.generate_key().decode())"
RNSR_TRAJECTORY_KEY=
RNSR_TRAJECTORY_RETENTION_DAYS=0  # 0 keeps trajectories forever

# ---------------------------------------------------------------------------
# Containment — confines model-written code to the corpus artifact.
# Only disable to debug the guard itself: matter documents are untrusted
# input, and the cell that reads them also writes code.
# ---------------------------------------------------------------------------
RNSR_SANDBOX_FS_GUARD=true

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
RNSR_LLM_SEED=42
RNSR_RUN_DIR=runs
RNSR_LOG_LEVEL=INFO
RNSR_LOG_FORMAT=text              # text for terminals, json for log shippers
